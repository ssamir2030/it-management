generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Accessory {
  id            String          @id
  name          String
  modelNumber   String?
  manufacturer  String?
  categoryId    String?
  totalQty      Int             @default(0)
  minQty        Int             @default(5)
  remainingQty  Int             @default(0)
  purchaseDate  DateTime?
  cost          Float?          @default(0)
  orderNumber   String?
  supplierId    String?
  locationId    String?
  image         String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  AssetCategory AssetCategory?  @relation(fields: [categoryId], references: [id])
  Location      Location?       @relation(fields: [locationId], references: [id])
  suppliers     suppliers?      @relation(fields: [supplierId], references: [id])
  AccessoryUser AccessoryUser[]

  @@index([categoryId])
}

model AccessoryUser {
  id           String    @id
  accessoryId  String
  userId       String?
  employeeId   String?
  assignedDate DateTime  @default(now())
  note         String?
  quantity     Int       @default(1)
  Accessory    Accessory @relation(fields: [accessoryId], references: [id])
  Employee     Employee? @relation(fields: [employeeId], references: [id])
  User         User?     @relation(fields: [userId], references: [id])

  @@index([accessoryId])
  @@index([employeeId])
  @@index([userId])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Article {
  id              String          @id
  title           String
  content         String
  excerpt         String?
  categoryId      String
  authorId        String
  views           Int             @default(0)
  isPublished     Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  User            User            @relation(fields: [authorId], references: [id])
  ArticleCategory ArticleCategory @relation(fields: [categoryId], references: [id])
}

model ArticleCategory {
  id          String    @id
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Article     Article[]
}

model Asset {
  id                    String                  @id
  tag                   String                  @unique
  serialNumber          String?
  name                  String
  type                  String
  model                 String?
  manufacturer          String?
  purchaseDate          DateTime?
  warrantyExpiry        DateTime?
  status                String                  @default("AVAILABLE")
  employeeId            String?
  locationId            String?
  processor             String?
  ram                   String?
  storage               String?
  operatingSystem       String?
  specifications        String?
  notes                 String?
  ipAddress             String?
  anydeskId             String?
  dwServiceId           String?
  price                 Float?                  @default(0)
  salvageValue          Float?                  @default(0)
  lifespan              Int?                    @default(36)
  floorPlanX            Float?
  floorPlanY            Float?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  deletedAt             DateTime?
  deletedBy             String?
  rackId                String?
  uPosition             Int?
  uHeight               Int                     @default(1)
  categoryId            String?
  assignedToId          String?
  assignedType          String?
  checkinCounter        Int                     @default(0)
  checkoutCounter       Int                     @default(0)
  parentAssetId         String?
  macAddress            String?
  AssetCategory         AssetCategory?          @relation(fields: [categoryId], references: [id])
  Employee              Employee?               @relation(fields: [employeeId], references: [id])
  Location              Location?               @relation(fields: [locationId], references: [id])
  Asset                 Asset?                  @relation("AssetToAsset", fields: [parentAssetId], references: [id])
  other_Asset           Asset[]                 @relation("AssetToAsset")
  racks                 racks?                  @relation(fields: [rackId], references: [id])
  AssetAudit            AssetAudit[]
  AssetTechnicalDetails AssetTechnicalDetails?
  CustodyItem           CustodyItem[]
  Document              Document[]
  RemoteAgent           RemoteAgent?
  employee_requests     employee_requests[]
  maintenance_schedules maintenance_schedules[]
  SoftwareLicense       SoftwareLicense[]

  @@index([categoryId])
  @@index([employeeId])
  @@index([locationId])
  @@index([rackId])
  @@index([status])
  @@index([type])
  @@index([warrantyExpiry])
}

model AssetAudit {
  id        String   @id
  assetId   String
  status    String
  notes     String?
  auditDate DateTime @default(now())
  Asset     Asset    @relation(fields: [assetId], references: [id])

  @@index([assetId])
}

model AssetCategory {
  id                  String          @id
  nameAr              String
  nameEn              String
  description         String?
  type                String          @default("OTHER")
  icon                String?
  prefix              String?
  parentId            String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime
  Accessory           Accessory[]
  Asset               Asset[]
  AssetCategory       AssetCategory?  @relation("AssetCategoryToAssetCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_AssetCategory AssetCategory[] @relation("AssetCategoryToAssetCategory")
  CustodyItem         CustodyItem[]
}

model AssetTechnicalDetails {
  id               String    @id
  computerName     String
  domainName       String
  brand            String
  processor        String
  ram              String
  storage          String
  serialNumber     String
  macAddress       String
  pcUserName       String
  management       String
  supportId        String
  os               String
  osKey            String
  office           String
  officeKey        String
  installationDate DateTime
  assetId          String    @unique
  employeeId       String?
  Asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  Employee         Employee? @relation(fields: [employeeId], references: [id])
}

model AuditRecord {
  id             String         @id
  auditId        String
  assetTag       String
  scannedAt      DateTime       @default(now())
  status         String
  notes          String?
  InventoryAudit InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([assetTag])
  @@index([auditId])
}

model AutomationRule {
  id          String    @id
  name        String
  description String?
  isActive    Boolean   @default(true)
  triggerType String
  conditions  String
  actions     String
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  createdBy   String?
}

model Consumable {
  id                    String                  @id
  name                  String
  description           String?
  categoryId            String?
  quantity              Int                     @default(0)
  minQuantity           Int                     @default(5)
  imageUrl              String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  bulkUnitName          String?
  conversionFactor      Int                     @default(1)
  unitName              String                  @default("بكت")
  ConsumableCategory    ConsumableCategory?     @relation(fields: [categoryId], references: [id])
  ConsumableTransaction ConsumableTransaction[]
}

model ConsumableCategory {
  id          String       @id
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Consumable  Consumable[]
}

model ConsumableTransaction {
  id           String     @id
  consumableId String
  employeeId   String?
  type         String
  quantity     Int
  notes        String?
  createdAt    DateTime   @default(now())
  unitName     String?
  Consumable   Consumable @relation(fields: [consumableId], references: [id])
  Employee     Employee?  @relation(fields: [employeeId], references: [id])
}

model CustodyItem {
  id             String         @id
  name           String
  description    String?
  employeeId     String
  assetId        String?
  assignedDate   DateTime       @default(now())
  returnDate     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  categoryId     String?
  isAcknowledged Boolean        @default(false)
  acknowledgedAt DateTime?
  acceptanceNote String?
  signature      String?
  Asset          Asset?         @relation(fields: [assetId], references: [id])
  AssetCategory  AssetCategory? @relation(fields: [categoryId], references: [id])
  Employee       Employee       @relation(fields: [employeeId], references: [id])

  @@index([categoryId])
}

model Department {
  id          String     @id
  name        String     @unique
  managerName String?
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  deletedAt   DateTime?
  deletedBy   String?
  floorPlanX  Float?
  floorPlanY  Float?
  Employee    Employee[]
}

model DiscoveredDevice {
  id           String   @id
  agentKey     String?  @unique
  ipAddress    String   @unique
  macAddress   String?
  hostname     String?
  manufacturer String?
  status       String   @default("NEW")
  lastSeen     DateTime @default(now())
  details      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([agentKey])
  @@index([lastSeen])
  @@index([status])
}

model Document {
  id                String    @id
  title             String
  type              String
  category          String?
  description       String?
  fileName          String
  fileSize          Int
  fileUrl           String
  mimeType          String?
  documentNumber    String?
  documentDate      DateTime?
  expiryDate        DateTime?
  amount            Float?
  currency          String?   @default("SAR")
  vendor            String?
  contactPerson     String?
  contactEmail      String?
  contactPhone      String?
  relatedAssetId    String?
  relatedEmployeeId String?
  status            String    @default("ACTIVE")
  tags              String    @default("")
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  createdBy         String?
  Asset             Asset?    @relation(fields: [relatedAssetId], references: [id])
  Employee          Employee? @relation(fields: [relatedEmployeeId], references: [id])

  @@index([documentDate])
  @@index([status])
  @@index([type])
}

model Employee {
  id                     String                   @id
  name                   String
  identityNumber         String                   @unique
  email                  String                   @unique
  phone                  String?
  jobTitle               String?
  departmentId           String?
  locationId             String?
  deletedAt              DateTime?
  deletedBy              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  password               String?
  image                  String?
  signature              String?
  chatStatus             String                   @default("BOT")
  lastChatClear          DateTime?
  floorPlanX             Float?
  floorPlanY             Float?
  managerId              String?
  AccessoryUser          AccessoryUser[]
  Asset                  Asset[]
  AssetTechnicalDetails  AssetTechnicalDetails[]
  ConsumableTransaction  ConsumableTransaction[]
  CustodyItem            CustodyItem[]
  Document               Document[]
  Department             Department?              @relation(fields: [departmentId], references: [id])
  Location               Location?                @relation(fields: [locationId], references: [id])
  Employee               Employee?                @relation("EmployeeToEmployee", fields: [managerId], references: [id])
  other_Employee         Employee[]               @relation("EmployeeToEmployee")
  TelecomService         TelecomService[]
  chat_messages          chat_messages[]
  employee_notifications employee_notifications[]
  employee_onboardings   employee_onboardings?
  employee_requests      employee_requests[]
  equipment_bookings     equipment_bookings[]
  room_bookings          room_bookings[]
  visits                 visits[]
  SoftwareLicense        SoftwareLicense[]

  @@index([departmentId])
  @@index([locationId])
}

model InventoryAudit {
  id          String        @id
  name        String
  startDate   DateTime      @default(now())
  endDate     DateTime?
  status      String        @default("OPEN")
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  AuditRecord AuditRecord[]
}

model InventoryItem {
  id                   String                 @id
  name                 String
  sku                  String?
  category             String
  manufacturer         String?
  model                String?
  serialNumber         String?
  barcode              String?
  quantity             Int                    @default(0)
  minQuantity          Int                    @default(5)
  unitPrice            Float?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  purchase_order_items purchase_order_items[]
}

model License {
  id             String    @id
  name           String
  vendor         String?
  version        String?
  licenseKey     String
  licenseType    String
  purchaseType   String
  purchaseDate   DateTime
  expiryDate     DateTime?
  cost           Float
  totalLicenses  Int       @default(1)
  usedLicenses   Int       @default(0)
  status         String    @default("ACTIVE")
  activationFile String?
  productKey     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
}

model Location {
  id             String          @id
  name           String
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  deletedAt      DateTime?
  deletedBy      String?
  googleMapsUrl  String?
  latitude       Float?
  longitude      Float?
  floorPlanImage String?
  layoutData     String?
  Accessory      Accessory[]
  Asset          Asset[]
  Employee       Employee[]
  NetworkDevice  NetworkDevice[]
  equipment      equipment[]
  racks          racks[]
  subnets        subnets[]
}

model NetworkDevice {
  id               String    @id
  name             String
  type             String
  brand            String?
  model            String?
  serialNumber     String?
  ipAddress        String?
  macAddress       String?
  subnetMask       String?
  gateway          String?
  vlan             String?
  username         String?
  password         String?
  sshPort          Int?      @default(22)
  managementUrl    String?
  status           String    @default("ACTIVE")
  locationId       String?
  firmwareVersion  String?
  installationDate DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Location         Location? @relation(fields: [locationId], references: [id])
}

model Notification {
  id         String   @id
  type       String
  title      String
  message    String
  read       Boolean  @default(false)
  userId     String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, read])
}

model OperationalItem {
  id                     String                 @id
  title                  String
  amount                 Float                  @default(0)
  spent                  Float                  @default(0)
  activityId             String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime
  operational_activities operational_activities @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model RemoteAgent {
  id            String          @id
  assetId       String          @unique
  dwAgentId     String          @unique
  installCode   String
  state         String          @default("WAITING_INSTALL")
  osType        String?
  agentVersion  String?
  lastOnline    DateTime?
  supportedApps String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Asset         Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  RemoteSession RemoteSession[]
}

model RemoteSession {
  id              String      @id
  agentId         String
  supportTicketId String?
  dwSessionId     String      @unique
  sessionUrl      String
  startTime       DateTime    @default(now())
  endTime         DateTime?
  duration        Int?
  status          String      @default("ACTIVE")
  purpose         String?
  startedBy       String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  RemoteAgent     RemoteAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model RequestSLA {
  id                String            @id
  requestId         String            @unique
  breachTime        DateTime
  isBreached        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  employee_requests employee_requests @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model SLA {
  id             String   @id
  name           String
  description    String?
  responseTime   Int
  resolutionTime Int
  priority       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SoftwareLicense {
  id           String     @id
  name         String
  key          String?
  type         String
  seats        Int        @default(1)
  usedSeats    Int        @default(0)
  purchaseDate DateTime?
  expiryDate   DateTime?
  cost         Float?     @default(0)
  supplierId   String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  healthScore  Float?     @default(100)
  suppliers    suppliers? @relation(fields: [supplierId], references: [id])
  Asset        Asset[]
  Employee     Employee[]

  @@index([expiryDate])
  @@index([supplierId])
}

model SoftwarePackage {
  id            String   @id
  name          String
  version       String
  downloadUrl   String
  silentArgs    String?
  description   String?
  isSystemAgent Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model Subscription {
  id            String   @id
  name          String
  provider      String?
  category      String
  startDate     DateTime
  renewalDate   DateTime
  cost          Float
  billingCycle  String
  email         String?
  managementUrl String?
  userLimit     Int?
  currentUsers  Int?     @default(0)
  status        String   @default("ACTIVE")
  autoRenew     Boolean  @default(true)
  alertDays     Int      @default(30)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model SystemLog {
  id        String   @id
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime
  updatedBy   String?
}

model TelecomService {
  id            String    @id
  type          String
  provider      String
  accountNumber String?
  phoneNumber   String?
  planDetails   String?
  cost          Float?
  billingCycle  String?
  employeeId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Employee      Employee? @relation(fields: [employeeId], references: [id])
}

model Ticket {
  id                             String            @id
  title                          String
  description                    String
  category                       String            @default("OTHER")
  status                         String            @default("OPEN")
  priority                       String            @default("MEDIUM")
  remoteAccessId                 String?
  remoteAccessPass               String?
  contactPhone                   String?
  assignedToId                   String?
  createdById                    String?
  employeeId                     String?
  employeeName                   String?
  employeeEmail                  String?
  employeePhone                  String?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime
  User_Ticket_assignedToIdToUser User?             @relation("Ticket_assignedToIdToUser", fields: [assignedToId], references: [id])
  User_Ticket_createdByIdToUser  User?             @relation("Ticket_createdByIdToUser", fields: [createdById], references: [id])
  ticket_messages                ticket_messages[]
  ticket_slas                    ticket_slas?
}

model User {
  id                                                String             @id
  name                                              String?
  email                                             String?            @unique
  emailVerified                                     DateTime?
  image                                             String?
  password                                          String?
  role                                              String             @default("USER")
  createdAt                                         DateTime           @default(now())
  updatedAt                                         DateTime
  lastChatClear                                     DateTime?
  deletedAt                                         DateTime?
  deletedBy                                         String?
  AccessoryUser                                     AccessoryUser[]
  Account                                           Account[]
  Article                                           Article[]
  Notification                                      Notification[]
  Session                                           Session[]
  SystemLog                                         SystemLog[]
  Ticket_Ticket_assignedToIdToUser                  Ticket[]           @relation("Ticket_assignedToIdToUser")
  Ticket_Ticket_createdByIdToUser                   Ticket[]           @relation("Ticket_createdByIdToUser")
  chat_messages_chat_messages_recipientUserIdToUser chat_messages[]    @relation("chat_messages_recipientUserIdToUser")
  chat_messages_chat_messages_userIdToUser          chat_messages[]    @relation("chat_messages_userIdToUser")
  reminders_reminders_assignedToIdToUser            reminders[]        @relation("reminders_assignedToIdToUser")
  reminders_reminders_createdByIdToUser             reminders[]        @relation("reminders_createdByIdToUser")
  ticket_messages                                   ticket_messages[]
  user_permissions                                  user_permissions[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model agent_commands {
  id           String    @id
  deviceId     String
  command      String
  status       String    @default("PENDING")
  result       String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  completedAt  DateTime?
  createdBy    String?

  @@index([createdAt])
  @@index([deviceId])
  @@index([status])
}

model alert_settings {
  id                     String   @id
  warrantyAlertDays      Int      @default(30)
  licenseAlertDays       Int      @default(30)
  maintenanceAlertDays   Int      @default(7)
  emailNotifications     Boolean  @default(true)
  dashboardNotifications Boolean  @default(true)
  notificationEmail      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
}

model announcements {
  id        String    @id
  title     String
  content   String
  type      String    @default("INFO")
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime
}

model audit_logs {
  id         String   @id
  userId     String
  userName   String
  action     String
  entityType String
  entityId   String
  entityName String?
  changes    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

model certificates {
  id                String   @id
  courseId          String
  employeeId        String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  courses           courses  @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([employeeId])
}

model chat_messages {
  id                                       String    @id
  content                                  String
  senderId                                 String
  senderType                               String
  userId                                   String?
  recipientUserId                          String?
  employeeId                               String?
  isRead                                   Boolean   @default(false)
  isBotMessage                             Boolean   @default(false)
  attachmentUrl                            String?
  createdAt                                DateTime  @default(now())
  Employee                                 Employee? @relation(fields: [employeeId], references: [id])
  User_chat_messages_recipientUserIdToUser User?     @relation("chat_messages_recipientUserIdToUser", fields: [recipientUserId], references: [id])
  User_chat_messages_userIdToUser          User?     @relation("chat_messages_userIdToUser", fields: [userId], references: [id])

  @@index([employeeId])
  @@index([recipientUserId])
  @@index([userId])
}

model comments {
  id         String   @id
  content    String
  entityType String
  entityId   String
  authorId   String
  authorType String
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([entityType, entityId])
}

model company_profiles {
  id              String   @id
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  nameAr          String
  nameEn          String
  taxNumber       String?
  commercialReg   String?
  email           String?
  phone           String?
  website         String?
  addressAr       String?
  addressEn       String?
  logoUrl         String?
  letterheadUrl   String?
  stampUrl        String?
  currency        String   @default("SAR")
  timezone        String   @default("Asia/Riyadh")
  fiscalYearStart String   @default("01-01")
  dateFormat      String   @default("DD/MM/YYYY")
}

model courses {
  id           String         @id
  title        String
  description  String?
  category     String
  imageUrl     String?
  videoUrl     String?
  duration     Int?
  isPublished  Boolean        @default(false)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  certificates certificates[]
  lessons      lessons[]
}

model employee_notifications {
  id         String    @id
  employeeId String
  type       String
  title      String
  message    String
  data       String?
  actionUrl  String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  priority   String    @default("NORMAL")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  Employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([employeeId])
  @@index([isRead])
}

model employee_onboardings {
  id          String    @id
  employeeId  String    @unique
  status      String    @default("IN_PROGRESS")
  tasks       String    @default("[]")
  startDate   DateTime  @default(now())
  completedAt DateTime?
  assignedTo  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model employee_requests {
  id                     String                @id
  type                   String
  serviceItemId          String?
  details                String?
  status                 String                @default("PENDING")
  subject                String?
  priority               String                @default("NORMAL")
  assignedTo             String?
  expectedCompletionDate DateTime?
  completedAt            DateTime?
  adminNotes             String?
  rejectionReason        String?
  employeeId             String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime
  feedback               String?
  rating                 Int?
  assetId                String?
  RequestSLA             RequestSLA?
  Asset                  Asset?                @relation(fields: [assetId], references: [id])
  Employee               Employee              @relation(fields: [employeeId], references: [id])
  service_items          service_items?        @relation(fields: [serviceItemId], references: [id])
  request_attachments    request_attachments[]
  request_timelines      request_timelines[]

  @@index([employeeId])
  @@index([serviceItemId])
  @@index([status])
}

model equipment {
